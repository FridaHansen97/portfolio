{
  "expo": {
    "name": "ChallengeResolver",
    "slug": "ChallengeResolver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "challengeresolver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "no.fridahansen.challegeresolver",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "899523437795-m301g3nks1u5rgt841es4c9svaf8d575.apps.googleusercontent.com"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "package": "no.fridahansen.challengeresolver",
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "no.fridahansen.challegeresolver"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ChallengeResolver uses your location to check that you are at the challenge."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ChallengeResolver uses the camera to take photo proof for challenges. ",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ChallengeResolver lets you choose photos as proof for the challenges.",
          "cameraPermission": "ChallengeResolver uses camera to take photo proof for challenges.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
